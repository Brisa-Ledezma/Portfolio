# Puerto en el que escucha la API.
PORT=3000

# Orígenes permitidos para el front (separados por coma).
CORS_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL. Opcional: sin ella los mensajes solo se envían por mail.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/portfolio

# Aviso por mail de cada mensaje de contacto (Gmail con contraseña de aplicación).
# Opcional: sin estos datos los mensajes solo se guardan en la base.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
